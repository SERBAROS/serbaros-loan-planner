# Variables que debes configurar en Coolify (Environment Variables del recurso),
# o en un .env junto a este docker-compose.yml si lo corres manualmente.

# --- Backend ---
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
CORS_ORIGIN=*

# --- MariaDB ---
DB_USERNAME=serbaros_loan_planner
DB_PASSWORD=cambia-esta-contraseña
DB_ROOT_PASSWORD=cambia-esta-contraseña-root
DB_DATABASE=serbaros_loan_planner

# Deja en false una vez que el esquema esté estable (evita cambios
# automáticos de estructura en producción). Puedes ponerlo en "true"
# solo en el primer despliegue para que TypeORM cree las tablas,
# y luego cambiarlo a "false" y redesplegar.
DB_SYNCHRONIZE=false
