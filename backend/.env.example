PORT=4000
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
CORS_ORIGIN=*

# MariaDB — para desarrollo local, levanta una con:
#   docker run -d --name serbaros-loan-planner-mariadb -p 3306:3306 \
#     -e MARIADB_DATABASE=serbaros_loan_planner -e MARIADB_USER=serbaros_loan_planner \
#     -e MARIADB_PASSWORD=serbaros_loan_planner -e MARIADB_ROOT_PASSWORD=root \
#     mariadb:11
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=serbaros_loan_planner
DB_PASSWORD=serbaros_loan_planner
DB_DATABASE=serbaros_loan_planner
# true crea/actualiza las tablas automáticamente (cómodo en desarrollo).
DB_SYNCHRONIZE=true
